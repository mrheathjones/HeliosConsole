          "title": "Enabled",
          "default": true
        },
        "availableReports": {
          "type": "array",
          "title": "Available Reports",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "title": "Report ID"
              },
              "enabled": {
                "type": "boolean",
