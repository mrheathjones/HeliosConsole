{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "com.herojoneslabs.helios.console.features",
  "title": "Helios Console — Features",
  "description": "Feature-module and tuning configuration for the Helios Console macOS apps (main console + menu bar). Preference domain: com.herojoneslabs.helios.console.features. Deploy as a Jamf Pro 'Application & Custom Settings' payload scoped to ALL managed Macs. This tier carries no secrets and no destructive capability, so broad scoping is safe. NOTE: these keys are parsed and exposed by the app's config layer; per-view enforcement status is tracked in docs/ConfigProfileMigration.md. Values take effect at app relaunch.",
  "type": "object",
  "properties": {
    "configurationVersion": {
      "type": "string",
      "title": "Configuration Version",
      "description": "Schema/profile version stamp (informational — the loader logs it, nothing else reads it).",
      "default": "2.0"
    },
    "computers": {
      "type": "object",
      "title": "Computers",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "default": true
        },
        "fetchInventory": {
          "type": "boolean",
          "title": "Fetch Inventory",
          "default": true
        },
        "showDashboardCard": {
          "type": "boolean",
          "title": "Show Dashboard Card",
          "default": true
        },
        "enableAPIActions": {
          "type": "boolean",
          "title": "Enable API Actions",
          "default": true
        },
        "enableReports": {
          "type": "boolean",
          "title": "Enable Reports",
          "default": true
        },
        "inventoryRefreshInterval": {
          "type": "integer",
          "title": "Inventory Refresh Interval (min)",
          "default": 15
        },
        "inventorySections": {
          "type": "array",
          "title": "Inventory Sections",
          "items": {
            "type": "string"
          },
          "default": [
            "GENERAL",
            "HARDWARE",
            "OPERATING_SYSTEM",
            "USER_AND_LOCATION",
            "DISK_ENCRYPTION",
            "SECURITY",
            "APPLICATIONS",
            "SOFTWARE_UPDATES",
            "PURCHASING",
            "GROUP_MEMBERSHIPS"
          ],
          "description": " Default = the sections the detail views render; removing sections blanks the matching UI. Empty list = default list."
        }
      }
    },
    "mobileDevices": {
      "type": "object",
      "title": "Mobile Devices",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "default": true
        },
        "fetchInventory": {
          "type": "boolean",
          "title": "Fetch Inventory",
          "default": true
        },
        "showDashboardCards": {
          "type": "object",
          "title": "Show Dashboard Cards",
          "properties": {
            "iOS": {
              "type": "boolean",
              "default": true
            },
            "iPadOS": {
              "type": "boolean",
              "default": true
            },
            "visionOS": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "enableAPIActions": {
          "type": "boolean",
          "title": "Enable API Actions",
          "default": true
        },
        "enableReports": {
          "type": "boolean",
          "title": "Enable Reports",
          "default": true
        },
        "inventoryRefreshInterval": {
          "type": "integer",
          "title": "Inventory Refresh Interval (min)",
          "default": 15
        },
        "inventorySections": {
          "type": "array",
          "title": "Inventory Sections",
          "items": {
            "type": "string"
          },
          "default": [
            "GENERAL",
            "HARDWARE",
            "USER_AND_LOCATION",
            "SECURITY",
            "NETWORK",
            "PURCHASING",
            "APPLICATIONS",
            "CERTIFICATES",
            "PROFILES",
            "GROUPS",
            "EXTENSION_ATTRIBUTES"
          ],
          "description": " Default = the sections the detail views render; removing sections blanks the matching UI. Empty list = default list."
        }
      }
    },
    "healthScorecard": {
      "type": "object",
      "title": "Health Scorecard",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "default": true
        },
        "metrics": {
          "type": "array",
          "title": "Scorecard Metrics",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "title": "Metric ID"
              },
              "enabled": {
                "type": "boolean",
                "title": "Enabled",
                "default": true
              },
              "displayName": {
                "type": "string",
                "title": "Display Name"
              },
              "thresholds": {
                "type": "object",
                "title": "Thresholds",
                "properties": {
                  "critical": {
                    "type": "integer",
                    "title": "Critical (%)"
                  },
                  "warning": {
                    "type": "integer",
                    "title": "Warning (%)"
                  }
                }
              },
              "checkedInDays": {
                "type": "integer",
                "title": "Checked-In Window (days)"
              },
              "platforms": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "title": "Platforms"
              },
              "minimumOSVersions": {
                "type": "object",
                "title": "Minimum Compliant OS Versions",
                "description": "Per-platform minimum OS MAJOR version counted as 'Up to Date'. Only meaningful on the softwareUpdateCompliance metric; drives BOTH the scorecard percentage and the drill-down device list.",
                "properties": {
                  "macOS": {
                    "type": "integer",
                    "title": "macOS",
                    "default": 26
                  },
                  "iOS": {
                    "type": "integer",
                    "title": "iOS",
                    "default": 26
                  },
                  "iPadOS": {
                    "type": "integer",
                    "title": "iPadOS",
                    "default": 26
                  },
                  "visionOS": {
                    "type": "integer",
                    "title": "visionOS",
                    "default": 2
                  }
                }
              }
            }
          },
          "default": [
            {
              "id": "checkedIn",
              "enabled": true,
              "displayName": "Recent Check-Ins",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS",
                "iOS",
                "iPadOS",
                "visionOS"
              ]
            },
            {
              "id": "managed",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS",
                "iOS",
                "iPadOS",
                "visionOS"
              ]
            },
            {
              "id": "supervised",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS",
                "iOS",
                "iPadOS",
                "visionOS"
              ]
            },
            {
              "id": "fileVaultEnabled",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS"
              ]
            },
            {
              "id": "firewallEnabled",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS"
              ]
            },
            {
              "id": "gatekeeperEnabled",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS"
              ]
            },
            {
              "id": "sipEnabled",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS"
              ]
            },
            {
              "id": "softwareUpdateCompliance",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS",
                "iOS",
                "iPadOS",
                "visionOS"
              ],
              "minimumOSVersions": {
                "macOS": 26,
                "iOS": 26,
                "iPadOS": 26,
                "visionOS": 2
              }
            }
          ]
        }
      }
    },
