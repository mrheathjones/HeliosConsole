{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "com.herojoneslabs.helios.console.features",
  "title": "Helios Console - Features",
  "description": "Feature-module and tuning configuration for Helios Console. Preference domain: com.herojoneslabs.helios.console.features \u2014 deploy as its own Jamf Pro Application & Custom Settings profile, scoped to all Macs running Helios (no secrets, safe to scope broadly). Values take effect at app relaunch.",
  "type": "object",
  "properties": {
    "configurationVersion": {
      "type": "string",
      "title": "Configuration Version",
      "description": "Schema/profile version stamp (informational \u2014 the loader logs it, nothing else reads it).",
      "default": "3.0"
    },
    "userExperience": {
      "type": "object",
      "title": "User Experience",
      "description": "Visibility switches for top-level app areas. Moved here from the ui domain \u2014 a ui profile still delivering these keys is honored until you re-push, but features wins when both are present. These only hide an area a role already grants; they never reveal one it withholds.",
      "properties": {
        "showAnnouncements": {
          "type": "boolean",
          "title": "Show Announcements",
          "description": "Show the Announcements area in the app.",
          "default": true
        },
        "showSettings": {
          "type": "boolean",
          "title": "Show Settings",
          "description": "Show the Settings area in the app.",
          "default": true
        }
      }
    },
    "localAdministration": {
      "type": "object",
      "title": "Local Administration",
      "description": "Local administrator account used by the LAPS password lookup in the device view. Moved here from the core domain \u2014 a core profile still delivering this block is honored until you re-push, but features wins when both are present.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "description": "Enable the LAPS password lookup.",
          "default": true
        },
        "username": {
          "type": "string",
          "title": "Local Admin Username",
          "description": "Short name of the managed local administrator account whose LAPS password Helios looks up.",
          "default": "macadmin"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "title": "Cleanup (Stale Device) Settings",
      "description": "Tunables for the Cleanup module \u2014 this block grants nothing. Which roles see the module and which sub-actions they may run stay in the access domain. Moved here from access \u2014 an access profile still delivering this block is honored until you re-push, but features wins when both are present.",
      "properties": {
        "staleDays": {
          "type": "integer",
          "title": "Stale Threshold (days)",
          "description": "Days without check-in before a device counts as stale. Users can change this in-app. Delivered as an integer; a string value is also tolerated.",
          "default": 90
        },
        "defaultStaticGroupID": {
          "type": "string",
          "title": "Default Static Group ID",
          "description": "Jamf static group ID pre-selected for Cleanup runs. Delivered as a string; parsed to an integer downstream.",
          "default": ""
        },
        "defaultSiteID": {
          "type": "string",
          "title": "Default Site ID",
          "description": "Jamf site ID pre-selected for Cleanup runs. Delivered as a string; parsed to an integer downstream.",
          "default": ""
        }
      }
    },
    "computers": {
      "type": "object",
      "title": "Computers",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "default": true
        },
        "fetchInventory": {
          "type": "boolean",
          "title": "Fetch Inventory",
          "default": true
        },
        "showDashboardCard": {
          "type": "boolean",
          "title": "Show Dashboard Card",
          "default": true
        },
        "enableReports": {
          "type": "boolean",
          "title": "Enable Reports",
          "default": true
        },
        "inventoryRefreshInterval": {
          "type": "integer",
          "title": "Inventory Refresh Interval (min)",
          "default": 15
        },
        "inventorySections": {
          "type": "array",
          "title": "Inventory Sections",
          "items": {
            "type": "string"
          },
          "default": [
            "GENERAL",
            "HARDWARE",
            "OPERATING_SYSTEM",
            "USER_AND_LOCATION",
            "DISK_ENCRYPTION",
            "SECURITY",
            "APPLICATIONS",
            "SOFTWARE_UPDATES",
            "PURCHASING",
            "GROUP_MEMBERSHIPS"
          ],
          "description": "Inventory sections fetched and rendered by the detail views. Removing a section blanks the matching UI. Empty list = default list."
        },
        "showDeviceHistory": {
          "type": "boolean",
          "title": "Show Device History",
          "default": false,
          "description": "Surface the per-device History section (Jamf Policy Logs + MDM command history from the Classic computerhistory endpoint). Default off."
        },
        "historyPageSize": {
          "type": "integer",
          "title": "History Page Size",
          "default": 25,
          "description": "Rows shown per page in the device History section (Policy Logs / Management History). Minimum 1."
        }
      }
    },
    "mobileDevices": {
      "type": "object",
      "title": "Mobile Devices",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "default": true
        },
        "fetchInventory": {
          "type": "boolean",
          "title": "Fetch Inventory",
          "default": true
        },
        "showDashboardCards": {
          "type": "object",
          "title": "Show Dashboard Cards",
          "properties": {
            "iOS": {
              "type": "boolean",
              "default": true
            },
            "iPadOS": {
              "type": "boolean",
              "default": true
            },
            "visionOS": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "enableReports": {
          "type": "boolean",
          "title": "Enable Reports",
          "default": true
        },
        "inventoryRefreshInterval": {
          "type": "integer",
          "title": "Inventory Refresh Interval (min)",
          "default": 15
        },
        "inventorySections": {
          "type": "array",
          "title": "Inventory Sections",
          "items": {
            "type": "string"
          },
          "default": [
            "GENERAL",
            "HARDWARE",
            "USER_AND_LOCATION",
            "SECURITY",
            "NETWORK",
            "PURCHASING",
            "APPLICATIONS",
            "CERTIFICATES",
            "PROFILES",
            "GROUPS",
            "EXTENSION_ATTRIBUTES"
          ],
          "description": "Inventory sections fetched and rendered by the detail views. Removing a section blanks the matching UI. Empty list = default list."
        }
      }
    },
    "myDevices": {
      "type": "object",
      "title": "My Devices",
      "description": "The read-only 'My Devices' module: how the signed-in identity is matched to a Jamf assigned user, and whether the local-Mac fallback is offered. Which roles can SEE the module is set in the access domain (roles[].modules = myDevices). API role privileges: Read Computers, Read Mobile Devices, and Read Users for the accurate identity match.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "description": "Machine-layer switch for the whole module. Off hides the sidebar row even for roles that grant it.",
          "default": true
        },
        "resolveDirectoryUsers": {
          "type": "boolean",
          "title": "Resolve Jamf User Records",
          "description": "Ask Jamf which user records carry the signed-in email address (/api/v1/users) and search inventory for every username they hold. This is the accurate match in tenants where the inventory username is a directory short name. Needs the Read Users privilege; a denial is non-fatal and falls back to the switches below.",
          "default": true
        },
        "matchEmail": {
          "type": "boolean",
          "title": "Match on Assigned Email",
          "description": "Match inventory records whose assigned-user email equals the signed-in address.",
          "default": true
        },
        "matchUsernameFromEmail": {
          "type": "boolean",
          "title": "Match Username = Sign-in Address",
          "description": "Match inventory records whose assigned username is the full sign-in address (tenants that enroll with the UPN as the username).",
          "default": true
        },
        "matchUsernameLocalPart": {
          "type": "boolean",
          "title": "Match Username = Address Local Part",
          "description": "Also try the part before the @ as a username. OFF by default: it matches nothing in short-name tenants and is the one candidate that could match a different person's device where mailboxes are shared.",
          "default": false
        },
        "matchRealName": {
          "type": "boolean",
          "title": "Match on Real Name",
          "description": "Match the assigned user's real name against the signed-in display name. OFF by default \u2014 display names are not unique and Jamf's formatting ('Doe, Jane A.') rarely equals the token's.",
          "default": false
        },
        "showLocalDeviceFallback": {
          "type": "boolean",
          "title": "Fall Back to This Mac",
          "description": "When nothing is assigned to the signed-in user, show the Mac Helios is running on (matched by serial), clearly labelled as this Mac rather than as an assignment.",
          "default": true
        },
        "maxDevices": {
          "type": "integer",
          "title": "Maximum Devices",
          "description": "Cap on devices shown, so a mis-scoped match (e.g. a shared lab account) cannot pull in the fleet. Minimum 1.",
          "default": 50
        }
      }
    },
    "healthScorecard": {
      "type": "object",
      "title": "Health Scorecard",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable Health Scorecard",
          "default": true
        },
        "cards": {
          "type": "array",
          "title": "Scorecard Cards",
          "description": "One entry per scorecard card. Each card measures ONE population (its site/group ids) against ONE standard. To hold two populations to different standards, use two cards. A card omitted here is not rendered.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "title": "Card",
                "enum": [
                  "checkedIn",
                  "protected",
                  "encrypted",
                  "secured",
                  "upToDate"
                ]
              },
              "enabled": {
                "type": "boolean",
                "title": "Enabled",
                "default": true
              },
              "thresholds": {
                "type": "object",
                "title": "Colour Thresholds",
                "properties": {
                  "critical": {
                    "type": "integer",
                    "default": 50
                  },
                  "warning": {
                    "type": "integer",
                    "default": 80
                  }
                }
              },
              "platforms": {
                "type": "array",
                "title": "Platforms",
                "items": {
                  "type": "string",
                  "enum": [
                    "macOS",
                    "iOS",
                    "iPadOS",
                    "visionOS"
                  ]
                }
              },
              "except": {
                "type": "array",
                "title": "Except",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "site",
                        "computerGroup",
                        "mobileGroup"
                      ],
                      "title": "Type"
                    },
                    "id": {
                      "type": "string",
                      "title": "Jamf ID"
                    },
                    "comment": {
                      "type": "string",
                      "title": "Comment"
                    }
                  }
                },
                "description": "Carve-out applied before targeting \u2014 for \"this site but not that group inside it\"."
              },
              "unmatchedVerdict": {
                "type": "string",
                "title": "Verdict For Untargeted Devices",
                "enum": [
                  "excluded",
                  "unknown"
                ],
                "default": "excluded",
                "description": "excluded removes untargeted devices from the card entirely. unknown keeps them visible as unevaluated, turning the card into a coverage audit."
              },
              "allDevices": {
                "type": "boolean",
                "title": "All Devices",
                "default": false,
                "description": "Measure every device, ignoring sites and groups. Must be stated explicitly \u2014 an empty target list means measure NOTHING, never everything."
              },
              "siteIds": {
                "type": "array",
                "title": "Jamf Site IDs",
                "items": {
                  "type": "string"
                },
                "description": "Jamf site IDs this card measures - not names, because a site renamed in Jamf keeps its id. Find them via Scope IDs on the Helios dashboard. A card with no site or group ids measures nothing and shows a setup state."
              },
              "computerGroupIds": {
                "type": "array",
                "title": "Computer Group IDs",
                "items": {
                  "type": "string"
                },
                "description": "Static or smart computer group ids. Separate from mobile group ids: they are different Jamf id namespaces."
              },
              "mobileGroupIds": {
                "type": "array",
                "title": "Mobile Device Group IDs",
                "items": {
                  "type": "string"
                }
              },
              "requiredApps": {
                "type": "array",
                "title": "Required Applications",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "title": "Application Name"
                    },
                    "matchMode": {
                      "type": "string",
                      "title": "Match Mode",
                      "enum": [
                        "exact",
                        "substring"
                      ],
                      "default": "exact",
                      "description": "exact matches \"Name\" or \"Name.app\". substring also matches things like \"Name Uninstaller.app\" \u2014 use only when the installed name varies."
                    }
                  }
                },
                "description": "Used by the protected card. Every listed app is required unless Require Mode is 'any'."
              },
              "requireMode": {
                "type": "string",
                "title": "Require Mode",
                "enum": [
                  "all",
                  "any"
                ],
                "default": "all"
              },
              "checks": {
                "type": "array",
                "title": "Security Checks",
                "description": "Used by the secured card.",
                "items": {
                  "type": "string",
                  "enum": [
                    "firewall",
                    "sip",
                    "gatekeeper",
                    "managed",
                    "supervised",
                    "diskEncrypted",
                    "bootstrapToken",
                    "ddm"
                  ]
                }
              },
              "checkedInDays": {
                "type": "integer",
                "title": "Check-In Window (days)",
                "default": 7,
                "description": "Used by the checkedIn card."
              },
              "minimumOSVersions": {
                "type": "object",
                "title": "Minimum OS Versions",
                "description": "Used by the upToDate card.",
                "properties": {
                  "macOS": {
                    "type": "integer",
                    "default": 26
                  },
                  "iOS": {
                    "type": "integer",
                    "default": 26
                  },
                  "iPadOS": {
                    "type": "integer",
                    "default": 26
                  },
                  "visionOS": {
                    "type": "integer",
                    "default": 2
                  }
                }
              }
            }
          }
        }
      }
    },
