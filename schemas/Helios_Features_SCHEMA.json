{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "com.herojoneslabs.helios.console.features",
  "title": "Helios Console — Features",
  "description": "Feature-module and tuning configuration for Helios Console. Preference domain: com.herojoneslabs.helios.console.features — deploy as its own Jamf Pro Application & Custom Settings profile, scoped to all Macs running Helios (no secrets, safe to scope broadly). Values take effect at app relaunch.",
  "type": "object",
  "properties": {
    "configurationVersion": {
      "type": "string",
      "title": "Configuration Version",
      "description": "Schema/profile version stamp (informational — the loader logs it, nothing else reads it).",
      "default": "3.0"
    },
    "userExperience": {
      "type": "object",
      "title": "User Experience",
      "description": "Visibility switches for top-level app areas. Moved here from the ui domain — a ui profile still delivering these keys is honored until you re-push, but features wins when both are present. These only hide an area a role already grants; they never reveal one it withholds.",
      "properties": {
        "showAnnouncements": {
          "type": "boolean",
          "title": "Show Announcements",
          "description": "Show the Announcements area in the app.",
          "default": true
        },
        "showSettings": {
          "type": "boolean",
          "title": "Show Settings",
          "description": "Show the Settings area in the app.",
          "default": true
        }
      }
    },
    "localAdministration": {
      "type": "object",
      "title": "Local Administration",
      "description": "Local administrator account used by the LAPS password lookup in the device view. Moved here from the core domain — a core profile still delivering this block is honored until you re-push, but features wins when both are present.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "description": "Enable the LAPS password lookup.",
          "default": true
        },
        "username": {
          "type": "string",
          "title": "Local Admin Username",
          "description": "Short name of the managed local administrator account whose LAPS password Helios looks up.",
          "default": "macadmin"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "title": "Cleanup (Stale Device) Settings",
      "description": "Tunables for the Cleanup module — this block grants nothing. Which roles see the module and which sub-actions they may run stay in the access domain. Moved here from access — an access profile still delivering this block is honored until you re-push, but features wins when both are present.",
      "properties": {
        "staleDays": {
          "type": "integer",
          "title": "Stale Threshold (days)",
          "description": "Days without check-in before a device counts as stale. Users can change this in-app. Delivered as an integer; a string value is also tolerated.",
          "default": 90
        },
        "defaultStaticGroupID": {
          "type": "string",
          "title": "Default Static Group ID",
          "description": "Jamf static group ID pre-selected for Cleanup runs. Delivered as a string; parsed to an integer downstream.",
          "default": ""
        },
        "defaultSiteID": {
          "type": "string",
          "title": "Default Site ID",
          "description": "Jamf site ID pre-selected for Cleanup runs. Delivered as a string; parsed to an integer downstream.",
          "default": ""
        }
      }
    },
    "computers": {
      "type": "object",
      "title": "Computers",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "default": true
        },
        "fetchInventory": {
          "type": "boolean",
          "title": "Fetch Inventory",
          "default": true
        },
        "showDashboardCard": {
          "type": "boolean",
          "title": "Show Dashboard Card",
          "default": true
        },
        "enableReports": {
          "type": "boolean",
          "title": "Enable Reports",
          "default": true
        },
        "inventoryRefreshInterval": {
          "type": "integer",
          "title": "Inventory Refresh Interval (min)",
          "default": 15
        },
        "inventorySections": {
          "type": "array",
          "title": "Inventory Sections",
          "items": {
            "type": "string"
          },
          "default": [
            "GENERAL",
            "HARDWARE",
            "OPERATING_SYSTEM",
            "USER_AND_LOCATION",
            "DISK_ENCRYPTION",
            "SECURITY",
            "APPLICATIONS",
            "SOFTWARE_UPDATES",
            "PURCHASING",
            "GROUP_MEMBERSHIPS"
          ],
          "description": "Inventory sections fetched and rendered by the detail views. Removing a section blanks the matching UI. Empty list = default list."
        }
      }
    },
    "mobileDevices": {
      "type": "object",
      "title": "Mobile Devices",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "default": true
        },
        "fetchInventory": {
          "type": "boolean",
          "title": "Fetch Inventory",
          "default": true
        },
        "showDashboardCards": {
          "type": "object",
          "title": "Show Dashboard Cards",
          "properties": {
            "iOS": {
              "type": "boolean",
              "default": true
            },
            "iPadOS": {
              "type": "boolean",
              "default": true
            },
            "visionOS": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "enableReports": {
          "type": "boolean",
          "title": "Enable Reports",
          "default": true
        },
        "inventoryRefreshInterval": {
          "type": "integer",
          "title": "Inventory Refresh Interval (min)",
          "default": 15
        },
        "inventorySections": {
          "type": "array",
          "title": "Inventory Sections",
          "items": {
            "type": "string"
          },
          "default": [
            "GENERAL",
            "HARDWARE",
            "USER_AND_LOCATION",
            "SECURITY",
            "NETWORK",
            "PURCHASING",
            "APPLICATIONS",
            "CERTIFICATES",
            "PROFILES",
            "GROUPS",
            "EXTENSION_ATTRIBUTES"
          ],
          "description": "Inventory sections fetched and rendered by the detail views. Removing a section blanks the matching UI. Empty list = default list."
        }
      }
    },
    "healthScorecard": {
      "type": "object",
      "title": "Health Scorecard",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "default": true
        },
        "metrics": {
          "type": "array",
          "title": "Scorecard Metrics",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "title": "Metric ID"
              },
              "enabled": {
                "type": "boolean",
                "title": "Enabled",
                "default": true
              },
              "displayName": {
                "type": "string",
                "title": "Display Name"
              },
              "thresholds": {
                "type": "object",
                "title": "Thresholds",
                "properties": {
                  "critical": {
                    "type": "integer",
                    "title": "Critical (%)"
                  },
                  "warning": {
                    "type": "integer",
                    "title": "Warning (%)"
                  }
                }
              },
              "checkedInDays": {
                "type": "integer",
                "title": "Checked-In Window (days)"
              },
              "platforms": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "title": "Platforms"
              },
              "minimumOSVersions": {
                "type": "object",
                "title": "Minimum Compliant OS Versions",
                "description": "Per-platform minimum OS MAJOR version counted as 'Up to Date'. Only meaningful on the softwareUpdateCompliance metric; drives BOTH the scorecard percentage and the drill-down device list.",
                "properties": {
                  "macOS": {
                    "type": "integer",
                    "title": "macOS",
                    "default": 26
                  },
                  "iOS": {
                    "type": "integer",
                    "title": "iOS",
                    "default": 26
                  },
                  "iPadOS": {
                    "type": "integer",
                    "title": "iPadOS",
                    "default": 26
                  },
                  "visionOS": {
                    "type": "integer",
                    "title": "visionOS",
                    "default": 2
                  }
                }
              }
            }
          },
          "default": [
            {
              "id": "checkedIn",
              "enabled": true,
              "displayName": "Recent Check-Ins",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS",
                "iOS",
                "iPadOS",
                "visionOS"
              ]
            },
            {
              "id": "managed",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS",
                "iOS",
                "iPadOS",
                "visionOS"
              ]
            },
            {
              "id": "supervised",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS",
                "iOS",
                "iPadOS",
                "visionOS"
              ]
            },
            {
              "id": "fileVaultEnabled",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS"
              ]
            },
            {
              "id": "firewallEnabled",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS"
              ]
            },
            {
              "id": "gatekeeperEnabled",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS"
              ]
            },
            {
              "id": "sipEnabled",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS"
              ]
            },
            {
              "id": "softwareUpdateCompliance",
              "enabled": true,
              "displayName": "",
              "thresholds": {
                "critical": 50,
                "warning": 80
              },
              "checkedInDays": 7,
              "platforms": [
                "macOS",
                "iOS",
                "iPadOS",
                "visionOS"
              ],
              "minimumOSVersions": {
                "macOS": 26,
                "iOS": 26,
                "iPadOS": 26,
                "visionOS": 2
              }
            }
          ]
        }
      }
    },
