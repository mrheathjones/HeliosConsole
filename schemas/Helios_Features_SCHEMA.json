    "actionLog": {
      "type": "object",
      "title": "Action Log Retention",
      "description": "Retention policy for the local MDM-action audit trail (~/Library/Application Support/Helios/Logs). Applied at app launch and on every new entry.",
      "properties": {
        "retentionDays": {
          "type": "integer",
          "title": "Retention (days)",
          "description": "Entries older than this are pruned. 0 = keep forever.",
          "default": 365
        },
        "maxEntries": {
          "type": "integer",
          "title": "Maximum Entries",
          "description": "Hard cap on entry count (oldest pruned first). 0 = unlimited.",
          "default": 10000
        }
      }
    }
