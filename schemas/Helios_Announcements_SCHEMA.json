{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "com.helios.console.announcements",
  "title": "Helios Console Announcements",
  "description": "MDM configuration schema for Helios Console announcements - deployed as a separate configuration profile",
  "type": "object",
  "properties": {
    "configurationVersion": {
      "type": "string",
      "description": "Schema version for compatibility checking",
      "default": "1.0"
    },
    "announcementsEnabled": {
      "type": "boolean",
      "description": "Master switch to enable/disable announcements feature",
      "default": true
    },
    "refreshInterval": {
      "type": "integer",
      "description": "How often to check for announcement updates (in minutes, 0 = manual only)",
      "default": 60,
      "minimum": 0,
      "maximum": 1440
    },
    "allowLocalFile": {
      "type": "boolean",
      "description": "Allow loading announcements from local JSON file (for testing)",
      "default": false
    },
    "allowUserDismiss": {
      "type": "boolean",
      "description": "Allow users to dismiss announcements globally",
      "default": true
    },
    "showUnreadBadge": {
      "type": "boolean",
      "description": "Show unread count badge in sidebar",
      "default": true
    },
    "notificationSettings": {
      "type": "object",
      "description": "System notification settings for announcements",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Send system notifications for new announcements",
          "default": false
        },
        "criticalOnly": {
          "type": "boolean",
          "description": "Only send notifications for critical announcements",
          "default": true
        },
        "sound": {
          "type": "boolean",
          "description": "Play sound with notification",
          "default": false
        }
      }
    },
    "announcements": {
      "type": "array",
      "description": "List of announcements to display",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the announcement",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "description": "Announcement title",
            "minLength": 1,
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "description": "Announcement message body (supports basic markdown)",
            "minLength": 1,
            "maxLength": 5000
          },
          "type": {
            "type": "string",
            "description": "Announcement type/category",
            "enum": [
              "info",
              "warning",
              "critical",
              "success",
              "maintenance",
              "update"
            ],
            "default": "info"
          },
          "priority": {
            "type": "string",
            "description": "Announcement priority level",
            "enum": [
              "low",
              "normal",
              "high",
              "urgent"
            ],
            "default": "normal"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Announcement creation/publish date (ISO 8601)"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Announcement expiration date (ISO 8601, optional)"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "description": "When to start showing the announcement (ISO 8601, optional)"
          },
          "dismissible": {
            "type": "boolean",
            "description": "Allow users to dismiss this announcement",
            "default": true
          },
          "requiredReading": {
            "type": "boolean",
            "description": "Mark as required reading (prevents dismissal until acknowledged)",
            "default": false
          },
          "requiresAcknowledgment": {
            "type": "boolean",
            "description": "Require explicit acknowledgment from user",
            "default": false
          },
          "actionURL": {
            "type": "string",
            "format": "uri",
            "description": "URL to open when action button is clicked"
          },
          "actionLabel": {
            "type": "string",
            "description": "Label for action button",
            "default": "Learn More",
            "maxLength": 50
          },
          "actionType": {
            "type": "string",
            "description": "How to handle the action URL",
            "enum": [
              "openURL",
              "openInApp",
              "downloadFile"
            ],
            "default": "openURL"
          },
          "targetAudience": {
            "type": "object",
            "description": "Target audience filters (optional)",
            "properties": {
              "departments": {
                "type": "array",
                "description": "List of department names to target",
                "items": {
                  "type": "string"
                }
              },
              "buildings": {
                "type": "array",
                "description": "List of building names to target",
                "items": {
                  "type": "string"
                }
              },
              "userGroups": {
                "type": "array",
                "description": "List of Jamf user group names to target",
                "items": {
                  "type": "string"
                }
              },
              "deviceGroups": {
                "type": "array",
                "description": "List of Jamf smart/static group names to target",
                "items": {
                  "type": "string"
                }
              },
              "platforms": {
                "type": "array",
                "description": "Target specific platforms",
                "items": {
                  "type": "string",
                  "enum": [
                    "macOS",
                    "iOS",
                    "iPadOS",
                    "visionOS"
                  ]
                }
              }
            }
          },
          "displayOptions": {
            "type": "object",
            "description": "Display customization options",
            "properties": {
              "showOnDashboard": {
                "type": "boolean",
                "description": "Show as banner on dashboard",
                "default": false
              },
              "modalOnStartup": {
                "type": "boolean",
                "description": "Show as modal when app starts",
                "default": false
              },
              "pinToTop": {
                "type": "boolean",
                "description": "Pin to top of announcements list",
                "default": false
              },
              "backgroundColor": {
                "type": "string",
                "description": "Custom background color (hex)",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "iconName": {
                "type": "string",
                "description": "Custom SF Symbol icon name"
              }
            }
          },
          "attachments": {
            "type": "array",
            "description": "File attachments (URLs)",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Display name for attachment"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "URL to attachment"
                },
                "type": {
                  "type": "string",
                  "description": "MIME type or file type",
                  "enum": [
                    "pdf",
                    "image",
                    "video",
                    "document",
                    "other"
                  ]
                },
                "size": {
                  "type": "string",
                  "description": "Human-readable file size"
                }
              },
              "required": [
                "name",
                "url"
              ]
            }
          },
          "metadata": {
            "type": "object",
            "description": "Custom metadata for tracking/filtering",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "title",
          "message"
        ]
      }
    },
    "scheduledMaintenanceWindows": {
      "type": "array",
      "description": "Pre-defined maintenance windows that generate automatic announcements",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier"
          },
          "title": {
            "type": "string",
            "description": "Maintenance window title"
          },
          "description": {
            "type": "string",
            "description": "Description of maintenance activities"
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "Maintenance start time (ISO 8601)"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "Maintenance end time (ISO 8601)"
          },
          "affectedServices": {
            "type": "array",
            "description": "List of affected services",
            "items": {
              "type": "string"
            }
          },
          "notifyBefore": {
            "type": "integer",
            "description": "Minutes before start to show announcement",
            "default": 60
          },
          "recurring": {
            "type": "object",
            "description": "Recurring schedule (optional)",
            "properties": {
              "frequency": {
                "type": "string",
                "enum": [
                  "daily",
                  "weekly",
                  "monthly"
                ]
              },
              "daysOfWeek": {
                "type": "array",
                "description": "For weekly: days of week (0=Sunday)",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                }
              },
              "dayOfMonth": {
                "type": "integer",
                "description": "For monthly: day of month",
                "minimum": 1,
                "maximum": 31
              }
            }
          }
        },
        "required": [
          "id",
          "title",
          "startTime",
          "endTime"
        ]
      }
    },
    "templates": {
      "type": "array",
      "description": "Reusable announcement templates",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Template identifier"
          },
          "name": {
            "type": "string",
            "description": "Template display name"
          },
          "type": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical",
              "success",
              "maintenance",
              "update"
            ]
          },
          "titleTemplate": {
            "type": "string",
            "description": "Title template with {{placeholders}}"
          },
          "messageTemplate": {
            "type": "string",
            "description": "Message template with {{placeholders}}"
          },
          "defaultPriority": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high",
              "urgent"
            ]
          },
          "defaultDuration": {
            "type": "integer",
            "description": "Default duration in hours before expiration"
          }
        },
        "required": [
          "id",
          "name",
          "titleTemplate",
          "messageTemplate"
        ]
      }
    }
  }
}