{
  "title": "Helios Console — Managed Configuration",
  "description": "Managed configuration for the Helios Console macOS app. Preference domain MUST equal the app's bundle identifier: com.helios.console. Values set here are FORCED and override the in-app Settings. Mirrors the deployed configuration profile. SECURITY: managed-preference plists are world-readable on disk — scope secrets (master client secret, ABM private key, Jamf Protect password) tightly, and scope the role=Admin profile (which can carry destructive Cleanup scopes) only to admin Macs.",
  "type": "object",
  "properties": {
    "configurationVersion": {
      "type": "string",
      "title": "Configuration Version",
      "description": "Schema/profile version stamp.",
      "default": "1.0"
    },
    "jamfPro": {
      "type": "object",
      "title": "Jamf Pro Connection",
      "properties": {
        "serverURL": {
          "type": "string",
          "title": "Jamf Pro Server URL",
          "description": "Full HTTPS base URL, no trailing slash. e.g. https://yourorg.jamfcloud.com"
        },
        "masterClientID": {
          "type": "string",
          "title": "Master API Client ID",
          "description": "OAuth client_id of the Jamf API Client used by Helios. Not secret."
        },
        "masterClientSecret": {
          "type": "string",
          "title": "Master API Client Secret",
          "description": "OAuth client_secret. Sensitive — managed-pref plists are readable on disk; scope the API Role tightly and rotate if exposed."
        },
        "requiredRoleName": {
          "type": "string",
          "title": "Required Jamf API Role Name",
          "description": "Name of the Jamf API Role the master client is expected to hold (informational)."
        },
        "screenShareEnabled": {
          "type": "boolean",
          "title": "Enable Screen Share",
          "default": true
        },
        "connectionTimeout": {
          "type": "integer",
          "title": "Connection Timeout (seconds)",
          "default": 30
        },
        "requestTimeout": {
          "type": "integer",
          "title": "Request Timeout (seconds)",
          "default": 60
        },
        "role": {
          "type": "string",
          "title": "Operator Role (jamfPro scope)",
          "description": "Mirror of the top-level role; the top-level `role` key is authoritative.",
          "enum": ["Admin", "Support", "User"],
          "default": "Admin"
        }
      },
      "required": ["serverURL", "masterClientID", "masterClientSecret"]
    },
    "appleBusinessManager": {
      "type": "object",
      "title": "Apple Business Manager (optional)",
      "properties": {
        "enabled": { "type": "boolean", "title": "Enable ABM", "default": true },
        "clientID": { "type": "string", "title": "ABM API Client ID" },
        "keyID": { "type": "string", "title": "ABM Key ID" },
        "privateKey": {
          "type": "string",
          "title": "ABM Private Key (PEM)",
          "description": "PEM-encoded ES256 private key for ABM JWT signing. Sensitive — scope tightly."
        }
      }
    },
    "localAdministration": {
      "type": "object",
      "title": "Local Administration",
      "properties": {
        "enabled": { "type": "boolean", "title": "Enabled", "default": true },
        "username": { "type": "string", "title": "Local Admin Username" }
      }
    },
    "computers": {
      "type": "object",
      "title": "Computers",
      "properties": {
        "enabled": { "type": "boolean", "title": "Enabled", "default": true },
        "fetchInventory": { "type": "boolean", "title": "Fetch Inventory", "default": true },
        "showDashboardCard": { "type": "boolean", "title": "Show Dashboard Card", "default": true },
        "enableAPIActions": { "type": "boolean", "title": "Enable API Actions", "default": true },
        "enableReports": { "type": "boolean", "title": "Enable Reports", "default": true },
        "inventoryRefreshInterval": { "type": "integer", "title": "Inventory Refresh Interval (min)", "default": 15 },
        "inventorySections": {
          "type": "array",
          "title": "Inventory Sections",
          "items": { "type": "string" },
          "default": ["GENERAL", "HARDWARE", "OPERATING_SYSTEM", "USER_AND_LOCATION", "STORAGE", "SECURITY", "DISK_ENCRYPTION", "CONFIGURATION_PROFILES", "GROUP_MEMBERSHIPS", "SOFTWARE_UPDATES"]
        }
      }
    },
    "mobileDevices": {
      "type": "object",
      "title": "Mobile Devices",
      "properties": {
        "enabled": { "type": "boolean", "title": "Enabled", "default": true },
        "fetchInventory": { "type": "boolean", "title": "Fetch Inventory", "default": true },
        "showDashboardCards": {
          "type": "object",
          "title": "Show Dashboard Cards",
          "properties": {
            "iOS": { "type": "boolean", "default": true },
            "iPadOS": { "type": "boolean", "default": true },
            "visionOS": { "type": "boolean", "default": true }
          }
        },
        "enableAPIActions": { "type": "boolean", "title": "Enable API Actions", "default": true },
        "enableReports": { "type": "boolean", "title": "Enable Reports", "default": true },
        "inventoryRefreshInterval": { "type": "integer", "title": "Inventory Refresh Interval (min)", "default": 15 },
        "inventorySections": {
          "type": "array",
          "title": "Inventory Sections",
          "items": { "type": "string" },
          "default": ["GENERAL", "HARDWARE", "USER_AND_LOCATION", "SECURITY", "CONFIGURATION_PROFILES", "GROUP_MEMBERSHIPS"]
        }
      }
    },
    "healthScorecard": {
      "type": "object",
      "title": "Health Scorecard",
      "properties": {
        "enabled": { "type": "boolean", "title": "Enabled", "default": true },
        "metrics": {
          "type": "array",
          "title": "Scorecard Metrics",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "title": "Metric ID" },
              "enabled": { "type": "boolean", "title": "Enabled", "default": true },
              "displayName": { "type": "string", "title": "Display Name" },
              "thresholds": {
                "type": "object",
                "title": "Thresholds",
                "properties": {
                  "critical": { "type": "integer", "title": "Critical (%)" },
                  "warning": { "type": "integer", "title": "Warning (%)" }
                }
              },
              "checkedInDays": { "type": "integer", "title": "Checked-In Window (days)" },
              "platforms": { "type": "array", "items": { "type": "string" }, "title": "Platforms" }
            }
          },
          "default": [
            { "id": "checkedIn", "enabled": true, "displayName": "Recent Check-Ins", "thresholds": { "critical": 50, "warning": 80 }, "checkedInDays": 7, "platforms": ["macOS", "iOS", "iPadOS", "visionOS"] },
            { "id": "managed", "enabled": true, "displayName": "", "thresholds": { "critical": 50, "warning": 80 }, "checkedInDays": 7, "platforms": ["macOS", "iOS", "iPadOS", "visionOS"] },
            { "id": "supervised", "enabled": true, "displayName": "", "thresholds": { "critical": 50, "warning": 80 }, "checkedInDays": 7, "platforms": ["macOS", "iOS", "iPadOS", "visionOS"] },
            { "id": "fileVaultEnabled", "enabled": true, "displayName": "", "thresholds": { "critical": 50, "warning": 80 }, "checkedInDays": 7, "platforms": ["macOS"] },
            { "id": "firewallEnabled", "enabled": true, "displayName": "", "thresholds": { "critical": 50, "warning": 80 }, "checkedInDays": 7, "platforms": ["macOS"] },
            { "id": "gatekeeperEnabled", "enabled": true, "displayName": "", "thresholds": { "critical": 50, "warning": 80 }, "checkedInDays": 7, "platforms": ["macOS"] },
            { "id": "sipEnabled", "enabled": true, "displayName": "", "thresholds": { "critical": 50, "warning": 80 }, "checkedInDays": 7, "platforms": ["macOS"] },
            { "id": "softwareUpdateCompliance", "enabled": true, "displayName": "", "thresholds": { "critical": 50, "warning": 80 }, "checkedInDays": 7, "platforms": ["macOS", "iOS", "iPadOS", "visionOS"] }
          ]
        }
      }
    },
    "deviceHealth": {
      "type": "object",
      "title": "Device Health",
      "properties": {
        "metrics": {
          "type": "array",
          "title": "Device Health Metrics",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "title": "Metric ID" },
              "enabled": { "type": "boolean", "title": "Enabled", "default": true },
              "displayName": { "type": "string", "title": "Display Name" },
              "category": { "type": "string", "title": "Category", "enum": ["management", "security", "status", "compliance"] },
              "platforms": { "type": "array", "items": { "type": "string" }, "title": "Platforms" }
            }
          },
          "default": [
            { "id": "managementStatus", "enabled": true, "displayName": "", "category": "management", "platforms": ["macOS", "iOS", "iPadOS", "visionOS"] },
            { "id": "supervisionStatus", "enabled": true, "displayName": "", "category": "management", "platforms": ["macOS", "iOS", "iPadOS", "visionOS"] },
            { "id": "mdmCapability", "enabled": true, "displayName": "", "category": "management", "platforms": ["macOS"] },
            { "id": "userApprovedMDM", "enabled": true, "displayName": "", "category": "management", "platforms": ["macOS"] },
            { "id": "bootstrapToken", "enabled": true, "displayName": "", "category": "management", "platforms": ["macOS"] },
            { "id": "fileVault", "enabled": true, "displayName": "", "category": "security", "platforms": ["macOS"] },
            { "id": "firewall", "enabled": true, "displayName": "", "category": "security", "platforms": ["macOS"] },
            { "id": "gatekeeper", "enabled": true, "displayName": "", "category": "security", "platforms": ["macOS"] },
            { "id": "sip", "enabled": true, "displayName": "", "category": "security", "platforms": ["macOS"] },
            { "id": "secureToken", "enabled": true, "displayName": "", "category": "security", "platforms": ["macOS"] },
            { "id": "recoveryLock", "enabled": true, "displayName": "", "category": "security", "platforms": ["macOS"] },
            { "id": "activationLock", "enabled": true, "displayName": "", "category": "security", "platforms": ["macOS", "iOS", "iPadOS", "visionOS"] },
            { "id": "remoteDesktop", "enabled": true, "displayName": "", "category": "status", "platforms": ["macOS"] },
            { "id": "softwareUpdate", "enabled": true, "displayName": "", "category": "compliance", "platforms": ["macOS", "iOS", "iPadOS", "visionOS"] },
            { "id": "lastCheckIn", "enabled": true, "displayName": "", "category": "status", "platforms": ["macOS", "iOS", "iPadOS", "visionOS"] },
            { "id": "appleCare", "enabled": true, "displayName": "", "category": "status", "platforms": ["macOS", "iOS", "iPadOS", "visionOS"] }
          ]
        }
      }
    },
    "deviceActions": {
      "type": "object",
      "title": "Device Actions (allow-list)",
      "properties": {
        "computer": {
          "type": "object",
          "title": "Computer Actions",
          "properties": {
            "sendBlankPush": { "type": "boolean", "default": true },
            "restart": { "type": "boolean", "default": true },
            "shutdown": { "type": "boolean", "default": true },
            "lock": { "type": "boolean", "default": false },
            "wipe": { "type": "boolean", "default": false },
            "enableRemoteDesktop": { "type": "boolean", "default": true },
            "disableRemoteDesktop": { "type": "boolean", "default": true },
            "enableBluetooth": { "type": "boolean", "default": true },
            "disableBluetooth": { "type": "boolean", "default": true },
            "viewRecoveryLockPassword": { "type": "boolean", "default": false },
            "viewFileVaultKey": { "type": "boolean", "default": true },
            "viewLocalAdminPassword": { "type": "boolean", "default": true },
            "unlockUserAccount": { "type": "boolean", "default": true },
            "renewMDMProfile": { "type": "boolean", "default": false },
            "sendCustomCommand": { "type": "boolean", "default": false },
            "updateInventory": { "type": "boolean", "default": false },
            "installPackage": { "type": "boolean", "default": false },
            "runPolicy": { "type": "boolean", "default": false }
          }
        },
        "mobileDevice": {
          "type": "object",
          "title": "Mobile Device Actions",
          "properties": {
            "sendBlankPush": { "type": "boolean", "default": true },
            "restart": { "type": "boolean", "default": true },
            "shutdown": { "type": "boolean", "default": true },
            "lock": { "type": "boolean", "default": true },
            "wipe": { "type": "boolean", "default": false },
            "clearPasscode": { "type": "boolean", "default": true },
            "enableLostMode": { "type": "boolean", "default": true },
            "disableLostMode": { "type": "boolean", "default": true },
            "playLostModeSound": { "type": "boolean", "default": true },
            "updateInventory": { "type": "boolean", "default": true },
            "renewMDMProfile": { "type": "boolean", "default": true },
            "enableActivationLock": { "type": "boolean", "default": false },
            "clearActivationLock": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "reports": {
      "type": "object",
      "title": "Reports",
      "properties": {
        "enabled": { "type": "boolean", "title": "Enabled", "default": true },
        "availableReports": {
          "type": "array",
          "title": "Available Reports",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "title": "Report ID" },
              "enabled": { "type": "boolean", "title": "Enabled", "default": true },
              "displayName": { "type": "string", "title": "Display Name" },
              "category": { "type": "string", "title": "Category" },
              "platforms": { "type": "array", "items": { "type": "string" }, "title": "Platforms" },
              "exportFormats": { "type": "array", "items": { "type": "string" }, "title": "Export Formats" }
            }
          },
          "default": [
            { "id": "deviceInventory", "enabled": true, "displayName": "", "category": "inventory", "platforms": ["macOS", "iOS", "iPadOS", "visionOS"], "exportFormats": ["csv", "json"] },
            { "id": "securityCompliance", "enabled": true, "displayName": "", "category": "security", "platforms": ["macOS"], "exportFormats": ["csv", "json"] },
            { "id": "softwareUpdates", "enabled": true, "displayName": "", "category": "compliance", "platforms": ["macOS", "iOS", "iPadOS", "visionOS"], "exportFormats": ["csv", "json"] },
            { "id": "applicationInventory", "enabled": true, "displayName": "", "category": "inventory", "platforms": ["macOS", "iOS", "iPadOS"], "exportFormats": ["csv", "json"] },
            { "id": "appleCareStatus", "enabled": true, "displayName": "", "category": "management", "platforms": ["macOS", "iOS", "iPadOS", "visionOS"], "exportFormats": ["csv", "json"] },
            { "id": "certificateExpiration", "enabled": true, "displayName": "", "category": "security", "platforms": ["macOS", "iOS", "iPadOS"], "exportFormats": ["csv", "json"] },
            { "id": "fileVaultStatus", "enabled": true, "displayName": "", "category": "security", "platforms": ["macOS"], "exportFormats": ["csv", "json"] },
            { "id": "configurationProfiles", "enabled": true, "displayName": "", "category": "management", "platforms": ["macOS", "iOS", "iPadOS", "visionOS"], "exportFormats": ["csv", "json"] }
          ]
        }
      }
    },
    "userInterface": {
      "type": "object",
      "title": "User Interface",
      "properties": {
        "appTitle": { "type": "string", "title": "App Title", "default": "Helios" },
        "appSubtitle": { "type": "string", "title": "App Subtitle", "default": "Console - Admin" },
        "supportURL": { "type": "string", "title": "Support URL" },
        "companyName": { "type": "string", "title": "Company Name" },
        "logoURL": { "type": "string", "title": "Logo URL" },
        "accentColor": { "type": "string", "title": "Accent Color (hex)", "default": "#007AFF" },
        "defaultColorScheme": { "type": "string", "title": "Default Color Scheme", "enum": ["system", "light", "dark"], "default": "system" },
        "showEnrollments": { "type": "boolean", "title": "Show Enrollments", "default": true },
        "showAnnouncements": { "type": "boolean", "title": "Show Announcements", "default": true },
        "showSettings": { "type": "boolean", "title": "Show Settings", "default": true }
      }
    },
    "SidebarItems": {
      "type": "array",
      "title": "Sidebar Items (optional override)",
      "description": "Optional custom sidebar item list. Leave empty to use the app's built-in sidebar.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "icon": { "type": "string" },
          "title": { "type": "string" },
          "isEnabled": { "type": "boolean", "default": true },
          "order": { "type": "integer" }
        }
      },
      "default": []
    },
    "authentication": {
      "type": "object",
      "title": "Authentication",
      "properties": {
        "requireBiometric": { "type": "boolean", "title": "Require Biometric", "default": false },
        "allowBiometricSetup": { "type": "boolean", "title": "Allow Biometric Setup", "default": true },
        "sessionTimeout": { "type": "integer", "title": "Session Timeout (min, 0 = none)", "default": 0 },
        "allowRememberMe": { "type": "boolean", "title": "Allow Remember Me", "default": true }
      }
    },
    "role": {
      "type": "string",
      "title": "Operator Role",
      "description": "Role-based access control (authoritative, top-level). The destructive Cleanup feature is shown ONLY when this is exactly \"Admin\"; Support, User, blank, missing, or a typo all hide it (fail-closed). Scope this profile so only intended admins receive role=Admin.",
      "enum": ["Admin", "Support", "User"],
      "default": "Admin"
    },
    "cleanup": {
      "type": "object",
      "title": "Cleanup (Stale Device) Settings",
      "description": "Defaults for the Admin-only Cleanup feature. staleDays is the DEFAULT stale threshold; users can change it in-app unless you re-deliver this profile to reset it.",
      "properties": {
        "staleDays": { "type": "integer", "title": "Stale Threshold (days)", "default": 30 },
        "defaultStaticGroupID": { "type": "string", "title": "Default Static Group ID" },
        "defaultSiteID": { "type": "string", "title": "Default Site ID" }
      }
    },
    "jamfProtect": {
      "type": "object",
      "title": "Jamf Protect (optional)",
      "description": "Optional Jamf Protect tenant connection for the Cleanup feature's Protect cards and independent Protect-record deletion.",
      "properties": {
        "enabled": { "type": "boolean", "title": "Enable Jamf Protect", "default": true },
        "url": { "type": "string", "title": "Jamf Protect Tenant URL", "description": "Full HTTPS tenant URL. e.g. https://yourorg.protect.jamfcloud.com" },
        "clientID": { "type": "string", "title": "Jamf Protect API Client ID" },
        "password": {
          "type": "string",
          "title": "Jamf Protect API Password (Client Secret)",
          "description": "The Jamf Protect API client's password/secret (the API authenticates with client_id + password). If set here it is used and the in-app field locks; if omitted, it is entered in the app and stored in the Keychain. Sensitive — managed-pref plists are world-readable; scope this profile tightly."
        }
      }
    }
  },
  "required": ["jamfPro"]
}
