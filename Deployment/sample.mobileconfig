<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
     Helios Console — managed configuration sample (v2 domain split).

     This ONE profile carries FIVE payloads, one per Helios preference
     domain, so it can be installed manually on a test Mac. In Jamf Pro,
     deploy these as FIVE SEPARATE Application & Custom Settings profiles
     instead — each domain has its own schema in schemas/ and its own
     scope (core/credentials/features/ui -> all managed Macs; access ->
     admin Macs ONLY). This single-file form exists for local/manual
     testing only. See docs/ConfigProfileMigration.md.
-->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>

		<!-- ============================================================
		     1/5  CORE — connection & integrations (no secrets).
		     Jamf scope: ALL managed Macs running Helios.
		     ============================================================ -->
		<dict>
			<key>PayloadType</key>
			<string>com.herojoneslabs.helios.console.core</string>
			<key>PayloadIdentifier</key>
			<string>com.herojoneslabs.helios.console.core.config</string>
			<key>PayloadUUID</key>
			<string>D575AB84-5E89-437F-8514-0887D14D54E3</string>
			<key>PayloadDisplayName</key>
			<string>Helios Console — Core</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadEnabled</key>
			<true/>

			<!-- Jamf Pro connection (master API client identity).
			     The matching client SECRET is in the credentials payload. -->
			<key>jamfPro</key>
			<dict>
				<key>serverURL</key>
				<string>https://yourorg.jamfcloud.com</string>
				<key>masterClientID</key>
				<string>REPLACE-WITH-MASTER-CLIENT-ID</string>
				<key>requiredRoleName</key>
				<string>HeliosConsoleAPIRole</string>

			<!-- Optional: name of the Jamf Extension Attribute holding a
			     device's VPN IP. When set, Screen Share prefers it over
			     the LAN IP. Empty/omitted = disabled.
			<key>vpnIPExtensionAttributeName</key>
			<string>EA_VPN_IP_ADDRESS</string> -->

			<!-- Optional: erase acknowledgment tuning. EVERY erase (Erase
			     Device / Return to Service) waits for the device to
			     acknowledge ERASE_DEVICE — no cleanup step runs without it.
			     Timeout clamped 30-1800; poll interval clamped 5-120.
			<key>eraseAckTimeoutSeconds</key>
			<integer>180</integer>
			<key>eraseAckPollIntervalSeconds</key>
			<integer>15</integer> -->
				<key>screenShareEnabled</key>
				<false/>
			</dict>

			<!-- Local admin (LAPS lookup) has MOVED to the features domain
			     (features > localAdministration) — see payload 4/5 below.
			     A profile still delivering it here keeps working (the app
			     falls back to it and logs a notice), but the features copy
			     wins when both are present. -->

			<!-- Optional Apple Business Manager connection. The PEM
			     private key goes in the credentials payload (abmPrivateKey). -->
			<!--
			<key>appleBusinessManager</key>
			<dict>
				<key>enabled</key>
				<true/>
				<key>clientID</key>
				<string>REPLACE-WITH-ABM-CLIENT-ID</string>
				<key>keyID</key>
				<string>REPLACE-WITH-ABM-KEY-ID</string>
			</dict>
			-->

			<!-- Optional Jamf Protect tenant. The API password goes in
			     the credentials payload (jamfProtectPassword) or is
			     entered in-app (Keychain) — never here. -->
			<!--
			<key>jamfProtect</key>
			<dict>
				<key>enabled</key>
				<true/>
				<key>url</key>
				<string>https://yourorg.protect.jamfcloud.com</string>
				<key>clientID</key>
				<string>REPLACE-WITH-PROTECT-CLIENT-ID</string>
			</dict>
			-->

			<!-- Optional Microsoft Entra cleanup POINTER. Points at a
			     separate managed domain holding the Graph credentials.
			     The credential domain name is admin-chosen — the value
			     below is only an example. An already-deployed credential
			     domain can be reused as-is; the identifier rebrand does
			     NOT require renaming your deployed credential plist
			     domain, just keep this pointer matching it. -->
			<!--
			<key>entra</key>
			<dict>
				<key>credentialDomain</key>
				<string>com.herojoneslabs.helios.console.entra</string>
			</dict>
			-->

			<!-- Optional interactive sign-in — IDENTITY ONLY. Omit the block
			     (as here) to keep the built-in email flow, in which case the
			     ACCESS payload's "role" key names the user's role instead.
			     method=entra replaces the email form with Microsoft Entra ID
			     sign-in via a SEPARATE PUBLIC-client app registration (no
			     secret exists for it, ever). Distinct from the entra cleanup
			     pointer above.

			     NO ROLE NAMES ARE CONFIGURED HERE. The app reads the token's
			     roles claim and looks each value up as a KEY in the ACCESS
			     payload's "roles" block — an Entra app-role Value must equal
			     a roles key EXACTLY (case-sensitive). Several matches = the
			     UNION of those roles; no match = sign-in REFUSED.

			     FAIL-CLOSED: entra with missing tenantId/clientId shows a
			     configuration error, never the email form. Also enable
			     "Assignment required" on the enterprise application so the
			     restriction is enforced Entra-side too. The ids below are
			     clearly-fake placeholders: set your real GUIDs in Jamf,
			     never in this repo. See docs/EntraAuthSetup.md. -->
			<!--
			<key>signIn</key>
			<dict>
				<key>method</key>
				<string>entra</string>
				<key>entra</key>
				<dict>
					<key>tenantId</key>
					<string>00000000-0000-0000-0000-000000000000</string>
					<key>clientId</key>
					<string>11111111-1111-1111-1111-111111111111</string>
					<key>provisionJamfCredentials</key>
					<true/>
				</dict>
			</dict>
			-->

			<!-- Sign-in behavior (MOVED here from the ui domain — this is
			     sign-in policy, so it belongs beside signIn above). A ui
			     profile still delivering `authentication` keeps working
			     (the app falls back to it and logs a notice), but this copy
			     wins when both are present. -->
			<key>authentication</key>
			<dict>
				<key>requireBiometric</key>
				<false/>
				<key>allowBiometricSetup</key>
				<true/>
				<!-- Idle lock, minutes; 0 disables. -->
				<key>sessionTimeout</key>
				<integer>0</integer>
				<key>allowRememberMe</key>
				<true/>
			</dict>
		</dict>

		<!-- ============================================================
		     2/5  CREDENTIALS — secrets only (rotate independently).
		     Jamf scope: ALL managed Macs running Helios (pair a
		     write-capable secret with the Admin access profile — same
		     Macs, see docs/ConfigProfileMigration.md).
		     WARNING: managed-pref plists are world-readable on disk.
		     ============================================================ -->
		<dict>
			<key>PayloadType</key>
			<string>com.herojoneslabs.helios.console.credentials</string>
			<key>PayloadIdentifier</key>
			<string>com.herojoneslabs.helios.console.credentials.config</string>
			<key>PayloadUUID</key>
			<string>469A647D-BA39-4503-8002-E0539CD03628</string>
			<key>PayloadDisplayName</key>
			<string>Helios Console — Credentials</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadEnabled</key>
			<true/>

			<!-- OAuth client_secret for jamfPro.masterClientID (core). -->
			<key>jamfProClientSecret</key>
			<string>REPLACE-WITH-jamf-pro-client-secret</string>

			<!-- Optional: PEM private key for the ABM connection (core). -->
			<!--
			<key>abmPrivateKey</key>
			<string>REPLACE-WITH-abm-private-key-pem</string>
			-->

			<!-- Optional: Jamf Protect API password. If delivered, the
			     in-app field locks; if omitted, in-app entry + Keychain
			     (com.herojoneslabs.helios.console.protect.password). -->
			<!--
			<key>jamfProtectPassword</key>
			<string>REPLACE-WITH-jamf-protect-password</string>
			-->
		</dict>

		<!-- ============================================================
		     3/5  ACCESS — role capabilities & destructive capability.
		     Nothing is hardcoded in the app: the "roles" block below is
		     the ONLY source of what any user can see or do.
		     FAIL-CLOSED: a Mac without this payload (or a role name that
		     matches no key) grants NOTHING — the user signs in to an
		     EMPTY app.
		     Jamf scope: ALL Macs running Helios (CHANGED in 2.4 — the
		     roles block must reach every Mac whose users need one).
		     Differentiate populations with per-variant "role" and
		     "deviceActions", not by withholding the profile.
		     ============================================================ -->
		<dict>
			<key>PayloadType</key>
			<string>com.herojoneslabs.helios.console.access</string>
			<key>PayloadIdentifier</key>
			<string>com.herojoneslabs.helios.console.access.config</string>
			<key>PayloadUUID</key>
			<string>94C2FE23-F28E-4ABB-B93B-5444B108C5F4</string>
			<key>PayloadDisplayName</key>
			<string>Helios Console — Access</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadEnabled</key>
			<true/>

			<!-- MDM-mode role name. Names ONE key in the "roles" block
			     below — free-form, exact, case-sensitive. IGNORED ENTIRELY
			     when the core payload configures Entra sign-in
			     (signIn.method=entra): role names then come from the Entra
			     token's roles claim instead. Absent/blank/unmatched = an
			     empty app (fail-closed). Ship one profile variant per Mac
			     population — e.g. this value on support Macs, and a
			     "Helios.Admin" variant on admin Macs. -->
			<key>role</key>
			<string>Helios.Support</string>

			<!-- ROLE DEFINITIONS — the capability source of truth.
			     An ARRAY of role objects, each naming itself in "name".
			     Every name below is one YOU choose; the app ships none.
			     In Entra mode a name must equal an app-role Value exactly
			     (case-sensitive); in MDM mode it must equal "role" above.
			     A user matching several roles gets the UNION of their
			     lists, and allowExport is OR'd.

			     An ARRAY (not a dictionary keyed by role name) so the
			     Jamf Pro Application & Custom Settings schema editor can
			     render this block as a form — same idiom as
			     "deviceActions.computer.actions" below. An entry with no
			     "name" is SKIPPED (nothing can match it); two entries
			     sharing a "name" are UNIONED, never replaced.

			     Device actions are TWO layers: "deviceActions" further
			     below says which actions EXIST on this Mac; the
			     computerActions/mobileDeviceActions lists here say which
			     of those each role may use. Only the intersection renders.
			     modules and cleanupActions are role-driven only.

			     SIDEBAR ORDER LIVES HERE: each role's "modules" ARRAY
			     ORDER is that role's sidebar order (first = topmost).
			     There is no "order" key — not here and not in the ui
			     domain, whose sidebarItems now carries presence, label,
			     and icon only. Arrange a role's modules and you have
			     arranged its sidebar; different roles may order the same
			     modules differently. "settings" is pinned below the
			     divider wherever it appears, and is listed LAST below to
			     read the way it renders.

			     Multi-role users get ONE merged list: this "roles" array
			     is walked in the order authored here (NOT the order the
			     Entra roles claim lists them), each matched role's
			     modules appended in listed order, first appearance wins.

			     Sign Out lives in the sidebar, so a role without the
			     "settings" module is not stranded. -->
			<key>roles</key>
			<array>

				<!-- Full access, including the destructive Cleanup module.
				     modules order = sidebar order: Dashboard lands first,
				     the destructive Cleanup module sits last of the real
				     rows, and settings is pinned below the divider. -->
				<dict>
					<key>name</key>
					<string>Helios.Admin</string>
					<key>modules</key>
					<array>
						<string>dashboard</string>
						<string>devices</string>
						<string>announcements</string>
						<string>logs</string>
						<string>reports</string>
						<string>enrollments</string>
						<string>cleanup</string>
						<string>settings</string>
					</array>
					<key>computerActions</key>
					<array>
						<string>sendBlankPush</string>
						<string>restart</string>
						<string>restartSilent</string>
						<string>shutdown</string>
						<string>enableRemoteDesktop</string>
						<string>disableRemoteDesktop</string>
						<string>enableBluetooth</string>
						<string>disableBluetooth</string>
						<string>screenShare</string>
						<string>viewFileVaultKey</string>
						<string>viewLocalAdminPassword</string>
						<string>unlockUserAccount</string>
						<string>wipe</string>
						<string>returnToService</string>
					</array>
					<key>mobileDeviceActions</key>
					<array>
						<string>sendBlankPush</string>
						<string>updateInventory</string>
					</array>
					<key>cleanupActions</key>
					<array>
						<string>unmanage</string>
						<string>addToGroup</string>
						<string>moveToSite</string>
						<string>deleteFromProtect</string>
						<string>deleteRecord</string>
					</array>
					<key>allowExport</key>
					<true/>
				</dict>

				<!-- Day-to-day support. Full operational surface incl. the
				     destructive erase paths, but NO Cleanup module and no
				     credential/secret disclosure (viewLocalAdminPassword,
				     viewFileVaultKey) or account-state change
				     (unlockUserAccount). Same sidebar order as
				     Helios.Admin, minus the cleanup row. -->
				<dict>
					<key>name</key>
					<string>Helios.Support</string>
					<key>modules</key>
					<array>
						<string>dashboard</string>
						<string>devices</string>
						<string>announcements</string>
						<string>logs</string>
						<string>reports</string>
						<string>enrollments</string>
						<string>settings</string>
					</array>
					<key>computerActions</key>
					<array>
						<string>sendBlankPush</string>
						<string>restart</string>
						<string>restartSilent</string>
						<string>shutdown</string>
						<string>enableRemoteDesktop</string>
						<string>disableRemoteDesktop</string>
						<string>enableBluetooth</string>
						<string>disableBluetooth</string>
						<string>screenShare</string>
						<string>wipe</string>
						<string>returnToService</string>
					</array>
					<key>mobileDeviceActions</key>
					<array>
						<string>sendBlankPush</string>
						<string>updateInventory</string>
					</array>
					<key>cleanupActions</key>
					<array/>
					<key>allowExport</key>
					<true/>
				</dict>

				<!-- Self-service end user. NOTE: "myDevice" is RESERVED for a
				     per-user single-device view shipping in a follow-up PR —
				     accepted today but INERT (unknown ids are ignored), so
				     this role currently renders Settings only and its benign
				     actions have no surface to appear on yet. Pre-staging it
				     is safe. It is listed FIRST so that it lands at the top
				     of the sidebar once it ships — no edit needed then. -->
				<dict>
					<key>name</key>
					<string>Helios.User</string>
					<key>modules</key>
					<array>
						<string>myDevice</string>
						<string>settings</string>
					</array>
					<key>computerActions</key>
					<array>
						<string>sendBlankPush</string>
						<string>restart</string>
						<string>enableBluetooth</string>
					</array>
					<key>mobileDeviceActions</key>
					<array/>
					<key>cleanupActions</key>
					<array/>
					<key>allowExport</key>
					<false/>
				</dict>

				<!-- Cleanup-only role — a supported pattern. Grants nothing
				     but the Cleanup module and its sub-actions; assign it in
				     Entra ALONGSIDE another role and the union applies (e.g.
				     Helios.Support + Helios.CleanupTech = the support surface
				     plus Cleanup). Uncomment to use.
				<dict>
					<key>name</key>
					<string>Helios.CleanupTech</string>
					<key>modules</key>
					<array>
						<string>cleanup</string>
					</array>
					<key>cleanupActions</key>
					<array>
						<string>addToGroup</string>
						<string>moveToSite</string>
					</array>
				</dict>
				-->
			</array>

			<!-- Cleanup TUNABLES have MOVED to the features domain
			     (features > cleanup) — see payload 4/5 below. This domain
			     is for GRANTS, and those tunables grant nothing. A profile
			     still delivering `cleanup` here keeps working (the app
			     falls back to it and logs a notice), but the features copy
			     wins when both are present. Set it there and drop it here.

			     The Cleanup MODULE is still granted here: "cleanup" in a
			     role's modules list, plus that role's cleanupActions. -->

			<!-- Device Actions allow-list — LAYER 1 OF 2, STRICT FAIL-CLOSED.
			     This block says which actions EXIST on THIS Mac; the
			     roles.<Name>.computerActions lists above say which of those
			     each USER may run. An action renders only when BOTH allow —
			     neither layer can expand what the other denies.

			     If this block (specifically computer.actions) is not
			     delivered, the device Actions menu is HIDDEN ENTIRELY. Only
			     actions listed with enabled=true appear; unlisted or disabled
			     ids are hidden AND blocked at execution. displayName
			     overrides the menu label only.
			     See schemas/Helios_Access_SCHEMA.json. -->
			<key>deviceActions</key>
			<dict>
				<key>computer</key>
				<dict>
					<key>actions</key>
					<array>
						<dict>
							<key>id</key><string>sendBlankPush</string>
							<key>enabled</key><true/>
						</dict>
						<dict>
							<key>id</key><string>restart</string>
							<key>enabled</key><true/>
						</dict>
						<dict>
							<key>id</key><string>restartSilent</string>
							<key>enabled</key><true/>
						</dict>
						<dict>
							<key>id</key><string>shutdown</string>
							<key>enabled</key><true/>
						</dict>
						<dict>
							<key>id</key><string>enableRemoteDesktop</string>
							<key>enabled</key><true/>
						</dict>
						<dict>
							<key>id</key><string>disableRemoteDesktop</string>
							<key>enabled</key><true/>
						</dict>
						<dict>
							<key>id</key><string>enableBluetooth</string>
							<key>enabled</key><true/>
						</dict>
						<dict>
							<key>id</key><string>disableBluetooth</string>
							<key>enabled</key><true/>
						</dict>
						<dict>
							<key>id</key><string>viewFileVaultKey</string>
							<key>enabled</key><true/>
						</dict>
						<dict>
							<key>id</key><string>viewLocalAdminPassword</string>
							<key>enabled</key><true/>
						</dict>
						<dict>
							<key>id</key><string>unlockUserAccount</string>
							<key>enabled</key><true/>
						</dict>
						<!-- Destructive / sensitive actions ship disabled;
						     flip to <true/> deliberately. -->
						<!-- wipe: bare erase — waits for device acknowledgment;
						     keeps the Jamf record and Entra object. -->
						<dict>
							<key>id</key><string>wipe</string>
							<key>enabled</key><false/>
						</dict>
						<!-- returnToService: each cleanup step below is
						     toggleable; the erase + acknowledgment always
						     happens first — no cleanup step runs without it. -->
						<dict>
							<key>id</key><string>returnToService</string>
							<key>enabled</key><false/>
							<key>options</key>
							<dict>
								<key>deleteJamfRecord</key><true/>
								<key>deleteEntraObject</key><true/>
							</dict>
						</dict>
						<dict>
							<key>id</key><string>screenShare</string>
							<key>enabled</key><false/>
						</dict>
					</array>
				</dict>
				<!-- Mobile-device allow-list is forward-looking: no mobile
				     actions menu exists yet. -->
				<key>mobileDevice</key>
				<dict>
					<key>actions</key>
					<array>
						<dict>
							<key>id</key><string>sendBlankPush</string>
							<key>enabled</key><true/>
						</dict>
						<dict>
							<key>id</key><string>updateInventory</string>
							<key>enabled</key><true/>
						</dict>
					</array>
				</dict>
			</dict>
		</dict>

		<!-- ============================================================
		     4/5  FEATURES — feature modules & tuning (no secrets).
		     Jamf scope: ALL managed Macs running Helios.
		     Omitted keys fall back to the schema defaults — deliver only
		     what you want to change (see schemas/Helios_Features_SCHEMA.json).
		     ============================================================ -->
		<dict>
			<key>PayloadType</key>
			<string>com.herojoneslabs.helios.console.features</string>
			<key>PayloadIdentifier</key>
			<string>com.herojoneslabs.helios.console.features.config</string>
			<key>PayloadUUID</key>
			<string>8969577E-3514-46BE-AC96-FAF63E152582</string>
			<key>PayloadDisplayName</key>
			<string>Helios Console — Features</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadEnabled</key>
			<true/>

			<!-- Example override; everything else keeps its default. -->
			<key>computers</key>
			<dict>
				<key>inventoryRefreshInterval</key>
				<integer>15</integer>
			</dict>

			<!-- Top-level area switches (MOVED here from the ui domain).
			     These only HIDE an area the signed-in role already grants —
			     they never reveal one it withholds. -->
			<key>userExperience</key>
			<dict>
				<key>showAnnouncements</key>
				<true/>
				<key>showSettings</key>
				<true/>
			</dict>

			<!-- Local admin account for the LAPS lookup in the device view
			     (MOVED here from the core domain). -->
			<key>localAdministration</key>
			<dict>
				<key>enabled</key>
				<true/>
				<key>username</key>
				<string>macadmin</string>
			</dict>

			<!-- Cleanup TUNABLES (MOVED here from the access domain).
			     Grants nothing — the Cleanup module and its sub-actions are
			     still role-gated in the access payload above. -->
			<key>cleanup</key>
			<dict>
				<key>staleDays</key>
				<integer>90</integer>
				<!-- Optional action-picker defaults: -->
				<!-- <key>defaultStaticGroupID</key><string>123</string> -->
				<!-- <key>defaultSiteID</key><string>1</string> -->
			</dict>
		</dict>

		<!-- ============================================================
		     5/5  UI — branding & UX (no secrets).
		     Jamf scope: ALL managed Macs running Helios.
		     ============================================================ -->
		<dict>
			<key>PayloadType</key>
			<string>com.herojoneslabs.helios.console.ui</string>
			<key>PayloadIdentifier</key>
			<string>com.herojoneslabs.helios.console.ui.config</string>
			<key>PayloadUUID</key>
			<string>19AC9CBA-9B2D-4983-B005-316499AD4286</string>
			<key>PayloadDisplayName</key>
			<string>Helios Console — UI</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadEnabled</key>
			<true/>

			<!-- User interface / branding. -->
			<key>userInterface</key>
			<dict>
				<key>appTitle</key>
				<string>Helios</string>
				<key>appSubtitle</key>
				<string>Console</string>
				<key>supportURL</key>
				<string>https://support.yourcompany.com</string>
			</dict>
		</dict>
	</array>
	<key>PayloadDisplayName</key>
	<string>Helios Console (all 5 domains — testing only)</string>
	<key>PayloadIdentifier</key>
	<string>com.herojoneslabs.helios.console.domains</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>9AD44C81-328D-47DF-8965-58BAB0C79F1D</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadOrganization</key>
